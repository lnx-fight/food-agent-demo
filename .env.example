# 阿里云百炼（必填：启用 Agent 对话、图片识别与联网营养检索）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 图片餐食识别必须使用视觉模型；qwen3-vl-flash 适合日常低延迟调用。
QWEN_VISION_MODEL=qwen3-vl-flash

# 文本对话、规划与联网检索使用文本模型。
QWEN_WEB_MODEL=qwen-plus
QWEN_CHAT_MODEL=qwen-plus
# Agent Eval 的语义评分模型；正式发布建议与 QWEN_CHAT_MODEL 使用不同模型。
QWEN_JUDGE_MODEL=
# 千问请求最多等待30秒；瞬时网络错误、429和服务端错误默认重试1次。
QWEN_REQUEST_TIMEOUT_MS=30000
QWEN_REQUEST_RETRIES=1
QWEN_RETRY_BASE_MS=500

# 以下服务为可选项。
# 正式托管必须使用持久存储；Render模板已挂载 /var/data。
# DATA_DIR=/var/data
# PUBLIC_ORIGIN=https://你的域名
# COOKIE_SECURE=true
# 只有确认托管代理会覆盖 X-Forwarded-For 时才启用。
# TRUST_PROXY=true
AMAP_WEB_SERVICE_KEY=
QWEN_EMBED_MODEL=text-embedding-v3
AGENT_MAX_TOOL_ROUNDS=6

# Cloudflare Pages：应用密钥配置在项目生产 Secret 中。
# Actions 单独使用仓库 Secret CLOUDFLARE_API_TOKEN；不要把它写到网页或源码。
# 本地部署临时 export CLOUDFLARE_API_TOKEN 后运行 npm run db:migrate / deploy:pages。
