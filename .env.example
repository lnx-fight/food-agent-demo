# 阿里云百炼（必填：启用 Agent 对话、图片识别与联网营养检索）
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 图片餐食识别必须使用视觉模型；qwen3-vl-flash 适合日常低延迟调用。
QWEN_VISION_MODEL=qwen3-vl-flash

# 文本对话、规划与联网检索使用文本模型。
QWEN_WEB_MODEL=qwen-plus
QWEN_CHAT_MODEL=qwen-plus

# 以下服务为可选项。
USDA_API_KEY=
AMAP_WEB_SERVICE_KEY=
QWEN_EMBED_MODEL=text-embedding-v3
AGENT_MAX_TOOL_ROUNDS=6
